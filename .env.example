# Copia este archivo como .env y ajusta los valores.

# --- Django ---
# Genera una clave con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esta-clave
DEBUG=True
# Lista separada por comas
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes HTTPS de confianza para CSRF en producción (separados por comas)
CSRF_TRUSTED_ORIGINS=

# --- Correo ---
# Desarrollo: los correos se imprimen en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Producción (SMTP): django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=webmaster@localhost
SERVER_EMAIL=root@localhost
